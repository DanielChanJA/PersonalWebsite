---
import { Image } from "astro:assets";
import portrait from "../assets/daniel-and-alpaca.jpg";
import { experiences } from "../data/experience";
import profile from "../data/profile.json";

const currentExperience = experiences.find((experience) => experience.current);
if (!currentExperience) throw new Error("Exactly one current experience is required.");

const impactMetrics = currentExperience.featuredImpact ?? [];
---

<section class="hero section-dark">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-two" aria-hidden="true"></div>

  <div class="shell hero-layout">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span></span> {profile.title}</p>
      <h1>I build secure systems that <em>scale.</em></h1>
      <p class="hero-intro">
        I’m {profile.firstName}, a security-focused software engineer turning complex identity,
        access, and infrastructure challenges into resilient platforms people can trust.
      </p>
      <div class="hero-actions">
        <a class="button button-accent" href="#experience">
          Explore my work
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"></path></svg>
        </a>
        <a class="text-link" href={`mailto:${profile.email}`}>
          Let’s talk
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="availability">
        <span class="pulse-dot" aria-hidden="true"></span>
        Based in the {profile.location.long}
      </div>
    </div>

    <div class="hero-visual reveal reveal-delay">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt={`${profile.name} smiling beside an alpaca`}
          widths={[360, 540, 720, 960]}
          sizes="(max-width: 820px) 82vw, 38vw"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
        <div class="portrait-label">
          <span>Security × Software</span>
          <span>01</span>
        </div>
      </div>
      <div class="floating-card">
        <span class="floating-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3 5 6v5c0 4.7 2.8 8.3 7 10 4.2-1.7 7-5.3 7-10V6l-7-3Z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </span>
        <span><strong>Building trust</strong> into every layer</span>
      </div>
    </div>
  </div>

  <div class="shell impact-strip reveal" aria-label="Selected career impact">
    {impactMetrics.map((metric) => (
      <div class="impact-item">
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))}
    <div class="impact-item impact-note">
      <span>Current chapter</span>
      <strong>{currentExperience.company}</strong>
    </div>
  </div>
</section>
